# Production build for the UAT/admin instance — serves a static `vite build`
# via nginx instead of running the Vite dev server. The dev server (used by
# docker-compose.yml for branch/LAN deployments) periodically re-optimizes
# dependencies on first access to a not-yet-bundled import and pushes a full
# page reload to every connected client over its HMR websocket — harmless on
# a single dev machine, but looks like random restarts on a shared UAT box.
#
# VITE_* vars are baked into the JS bundle at build time (see src/api/index.js)
# so they're passed as build args, not container-runtime environment.

FROM node:lts-alpine AS build
WORKDIR /app
COPY package.json yarn.lock .
RUN yarn --frozen-lockfile
COPY . .

ARG VITE_APP_ENV
ARG VITE_ROLE
ARG VITE_ALLOW_POS_ON_ADMIN
ARG VITE_APP_SERVER_PORT
ARG VITE_APP_BASE_NAME
ENV VITE_APP_ENV=$VITE_APP_ENV \
    VITE_ROLE=$VITE_ROLE \
    VITE_ALLOW_POS_ON_ADMIN=$VITE_ALLOW_POS_ON_ADMIN \
    VITE_APP_SERVER_PORT=$VITE_APP_SERVER_PORT \
    VITE_APP_BASE_NAME=$VITE_APP_BASE_NAME
RUN yarn build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.uat.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
